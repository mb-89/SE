{
  "name": "se",
  "version": "15.1.0",
  "description": "SE, the agent a person talks to, with its integrator, worker and reviewer sub-agents and their skills.",
  "license": "MIT",
  "agents": "agents/",
  "skills": "skills/",
  "hooks": ".github/plugin/hooks.json",
  "mcpServers": {
    "se": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${PLUGIN_ROOT}/scripts/se_mcp.sh",
        "--root",
        "."
      ],
      "env": {
        "SE_SESSION_CWD": "${COPILOT_SESSION_CWD}"
      }
    }
  }
}
