{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "bash scripts/bootstrap.sh --hook || true",
        "powershell": "bash scripts/bootstrap.sh --hook; exit 0",
        "cwd": ".",
        "env": {
          "SE_HOOK_HOST": "copilot"
        },
        "timeoutSec": 120
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "bash": "bash scripts/se_hook.sh PreToolUse || true",
        "powershell": "bash scripts/se_hook.sh PreToolUse; exit 0",
        "cwd": ".",
        "env": {
          "SE_HOOK_HOST": "copilot"
        },
        "timeoutSec": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "bash scripts/se_hook.sh Stop || [ $? -ne 2 ] || exit 2",
        "powershell": "bash scripts/se_hook.sh Stop; if ($LASTEXITCODE -eq 2) { exit 2 }; exit 0",
        "cwd": ".",
        "env": {
          "SE_HOOK_HOST": "copilot"
        },
        "timeoutSec": 60
      }
    ]
  }
}
