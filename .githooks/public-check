#!/bin/sh
# Runs se's public-safety check (rule: AGENTS.md "Public safety") on the repository in the working
# directory. Called by the hooks next to it; projects that use se as a module point their
# core.hooksPath here, so the check is never copied.
script="$(dirname "$0")/../scripts/public_check.py"
if command -v uv >/dev/null 2>&1; then
    exec uv run --no-project --quiet python "$script" "$@"
fi
for python in python3 python; do
    if "$python" -c "import sys; sys.exit(sys.version_info < (3, 11))" >/dev/null 2>&1; then
        exec "$python" "$script" "$@"
    fi
done
echo "public-check: error: needs uv or Python 3.11+; refusing" >&2
exit 2
