#!/bin/sh
# Public-safety check of every pushed commit: the pushed tree, messages and identities.
check="$(dirname "$0")/public-check"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac  # branch deletion
    if case "$remote_sha" in *[!0]*) true ;; *) false ;; esac &&
        git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$remote_sha..$local_sha"
    else
        range="$local_sha --not --remotes"
    fi
    "$check" --rev "$local_sha" --range "$range" </dev/null || status=1
done
exit $status
