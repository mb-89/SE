#!/bin/sh
# Public-safety check of every pushed commit the destination remote does not hold yet: the pushed
# tree, messages and identities, with the local list's `remote:<name>` lines for that remote
# (public_check.py --remote). git names the remote as $1, so a commit fetched from another remote
# is checked on its way here; a URL with a space names no remote's refs and excludes none. A push
# to the integration branch also needs a passing suite and public check recorded on the pushed
# tree (work_tickets.py verified, the same guard work_tickets.py push runs). Its git goes through
# se's git door (scripts/git_door.py), as every git command se runs does.
script="$(dirname "$0")/se-script"
remote="$1"
case "$remote" in *[[:space:]]*) held="" ;; *) held=" --not --remotes=$remote" ;; esac
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac  # branch deletion
    if case "$remote_sha" in *[!0]*) true ;; *) false ;; esac &&
        "$script" git_door.py cat-file -e "$remote_sha^{commit}" </dev/null >/dev/null 2>&1; then
        range="$remote_sha..$local_sha$held"
    else
        range="$local_sha$held"
    fi
    "$script" public_check.py --rev "$local_sha" --remote "$remote" --range "$range" </dev/null || status=1
    "$script" work_tickets.py verified "$remote_ref" "$local_sha" </dev/null || status=1
done
exit $status
