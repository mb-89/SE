{
  "permissions": {
    "allow": [
      "Bash(./src/plugin/bin/se issue:*)",
      "Bash(./src/plugin/bin/se fleet:*)",
      "Bash(./src/plugin/bin/se review:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-skip.sh\""
          }
        ]
      }
    ]
  }
}
